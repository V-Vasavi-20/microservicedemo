pipeline {

    agent any

    parameters {
        booleanParam(
            name: 'INITIAL_BUILD',
            defaultValue: false,
            description: 'Build and push all microservice images for the initial deployment'
        )
    }

    tools {
        jdk 'jdk21'
        maven 'maven-3.9'
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        ECR_REGISTRY   = '872792314712.dkr.ecr.ap-south-1.amazonaws.com'
        EKS_CLUSTER    = 'vasavi-infra-dev-eks'
        IMAGE_TAG      = "${GIT_COMMIT[0..7]}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Verify Prerequisites') {
            steps {
                sh '''
                    echo "Verifying required tools are installed..."
                    docker --version
                    trivy --version
                    kubectl version --client
                    helm version --short
                    aws --version
                    echo "All required tools verified."
                '''
                script {
                    def nexusIp = sh(
                        script: "aws ec2 describe-instances --filters 'Name=tag:Name,Values=vasavi-infra-dev-nexus-instance' 'Name=instance-state-name,Values=running' --query 'Reservations[0].Instances[0].PrivateIpAddress' --output text --region ap-south-1",
                        returnStdout: true
                    ).trim()
                    env.NEXUS_REGISTRY = "${nexusIp}:8081"
                    echo "Resolved NEXUS_REGISTRY: ${env.NEXUS_REGISTRY}"
                    env.FAILED_SERVICES = ''
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changed Services') {
            steps {
                script {
                    def allServices = ['auth-service', 'gateway-service', 'user-service',
                                        'admin-service', 'employee-service', 'customer-service',
                                        'hr-service', 'task-service']

                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || echo ''",
                        returnStdout: true
                    ).trim().split('\n')

                    if (params.INITIAL_BUILD) {
                        env.CHANGED_SERVICES = allServices.join(',')
                    } else {
                        env.CHANGED_SERVICES = allServices.findAll { service ->
                            changedFiles.any { it.startsWith(service + '/') }
                        }.join(',')
                    }

                    if (env.CHANGED_SERVICES == '') {
                        echo 'No microservice changes detected. Skipping build.'
                        currentBuild.result = 'SUCCESS'
                    } else {
                        echo "Changed services: ${env.CHANGED_SERVICES}"
                    }
                }
            }
        }

        stage('Build Parent POM and Common Library') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                sh 'mvn -N install'
                dir('common-library') {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Pre-download Trivy Databases') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                sh '''
                    export TMPDIR=/var/lib/jenkins/trivy-cache-shared
                    mkdir -p /var/lib/jenkins/trivy-cache-shared
                    trivy image --cache-dir /var/lib/jenkins/trivy-cache-shared --download-db-only
                    trivy image --cache-dir /var/lib/jenkins/trivy-cache-shared --download-java-db-only
                '''
            }
        }

        stage('Build') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        try {
                            dir(service) {
                                sh 'mvn clean compile'
                            }
                        } catch (e) {
                            echo "Build failed for ${service}: ${e.message}. Continuing with remaining services."
                            env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                        }
                    }
                }
            }
        }

        stage('Test') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            try {
                                dir(service) {
                                    sh 'mvn test'
                                }
                            } catch (e) {
                                echo "Test failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Test for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            try {
                                dir(service) {
                                    withSonarQubeEnv('SonarQube') {
                                        sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.11.0.3922:sonar'
                                    }
                                }
                            } catch (e) {
                                echo "SonarQube Analysis failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping SonarQube Analysis for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            try {
                                sh "docker build -f ${service}/Dockerfile -t ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG} ."
                            } catch (e) {
                                echo "Docker Build failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Docker Build for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            try {
                                retry(6) {
                                    sh """
                                        export TMPDIR=/var/lib/jenkins/trivy-cache-shared
                                        sleep \$((RANDOM % 30))
                                        trivy image --cache-dir /var/lib/jenkins/trivy-cache-shared --ignorefile ${WORKSPACE}/.trivyignore --skip-db-update --skip-java-db-update --severity HIGH,CRITICAL --exit-code 1 ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                    """
                                }
                            } catch (e) {
                                echo "Trivy Scan failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Trivy Scan for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('Push Images') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            try {
                                sh """
                                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                                    docker push ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                """
                                retry(3) {
                                    withCredentials([usernamePassword(credentialsId: 'nexus-credentials', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                                        sh """
                                            sleep \$((RANDOM % 25 + 15))
                                            docker login ${NEXUS_REGISTRY} -u \$NEXUS_USER -p \$NEXUS_PASS
                                            docker tag ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG} ${NEXUS_REGISTRY}/microservices-docker/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                            docker push ${NEXUS_REGISTRY}/microservices-docker/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                        """
                                    }
                                }
                            } catch (e) {
                                echo "Push Images failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Push Images for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('EKS Authentication') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                sh "aws eks update-kubeconfig --name ${EKS_CLUSTER} --region ${AWS_REGION} --kubeconfig /tmp/kubeconfig-pipeline-${BUILD_NUMBER}"
            }
        }

        stage('Helm Deploy') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            def namespace = service.replace('-service', '')
                            try {
                                retry(5) {
                                    sh """
                                        export KUBECONFIG=/tmp/kubeconfig-pipeline-${BUILD_NUMBER}
                                        sleep \$((RANDOM % 15))
                                        helm upgrade crm-platform helm/crm --reuse-values \\
                                            --set services.${namespace}.image=vasavi-infra-dev-${service} \\
                                            --set services.${namespace}.tag=${IMAGE_TAG}
                                    """
                                }
                            } catch (e) {
                                echo "Helm Deploy failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Helm Deploy for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('Rollout Status') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            def namespace = service.replace('-service', '')
                            try {
                                sh """
                                    export KUBECONFIG=/tmp/kubeconfig-pipeline-${BUILD_NUMBER}
                                    kubectl rollout status deployment/${service} -n ${namespace} --timeout=300s
                                """
                            } catch (e) {
                                echo "Rollout Status failed for ${service}: ${e.message}. Continuing with remaining services."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Rollout Status for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }

        stage('Smoke Test') {
            when { expression { env.CHANGED_SERVICES != '' } }
            steps {
                script {
                    def ports = ['auth-service': 8081, 'gateway-service': 8080, 'user-service': 8082,
                                 'admin-service': 8082, 'employee-service': 8083, 'customer-service': 8084,
                                 'hr-service': 8085, 'task-service': 8089]
                    env.CHANGED_SERVICES.split(',').each { service ->
                        if (!env.FAILED_SERVICES.split(',').contains(service)) {
                            def namespace = service.replace('-service', '')
                            def port = ports[service]
                            try {
                                sh """
                                    export KUBECONFIG=/tmp/kubeconfig-pipeline-${BUILD_NUMBER}
                                    sleep 10
                                    kubectl run smoke-test-${service}-${BUILD_NUMBER} --rm -i --restart=Never \\
                                        --image=curlimages/curl \\
                                        -- curl -sf http://${service}.${namespace}.svc.cluster.local:${port}/actuator/health
                                """
                            } catch (e) {
                                echo "Smoke Test failed for ${service}: ${e.message}."
                                env.FAILED_SERVICES = (env.FAILED_SERVICES + ',' + service).trim(',')
                            }
                        } else {
                            echo "Skipping Smoke Test for ${service} (already failed earlier stage)"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            script {
                if (env.FAILED_SERVICES?.trim()) {
                    echo "Pipeline completed with some failures: ${env.FAILED_SERVICES}"
                } else {
                    echo "Pipeline succeeded for changed services: ${env.CHANGED_SERVICES}"
                }
            }
        }
        failure {
            echo "Pipeline failed. Check the stage logs above for the genuine root cause."
        }
    }
}
