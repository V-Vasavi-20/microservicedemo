pipeline {

    agent any

    tools {
        jdk 'jdk21'
        maven 'maven-3.9'
    }

    environment {
        AWS_REGION     = 'ap-south-1'
        ECR_REGISTRY   = '872792314712.dkr.ecr.ap-south-1.amazonaws.com'
        EKS_CLUSTER    = 'vasavi-infra-dev-eks'
        IMAGE_TAG      = "${GIT_COMMIT[0..7]}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changed Services') {
            steps {
                script {
                    def allServices = ['auth-service', 'gateway-service', 'user-service',
                                        'admin-service', 'employee-service', 'customer-service',
                                        'hr-service', 'task-service']

                    def changedFiles = sh(
                        script: "git diff --name-only HEAD~1 HEAD || echo ''",
                        returnStdout: true
                    ).trim().split('\n')

                    env.CHANGED_SERVICES = allServices.findAll { service ->
                        changedFiles.any { it.startsWith(service + '/') }
                    }.join(',')

                    if (env.CHANGED_SERVICES == '') {
                        echo 'No microservice changes detected. Skipping build.'
                        currentBuild.result = 'SUCCESS'
                    } else {
                        echo "Changed services: ${env.CHANGED_SERVICES}"
                    }
                }
            }
        }

        stage('Build, Scan, and Deploy Each Changed Service') {
            when {
                expression { env.CHANGED_SERVICES != '' }
            }
            steps {
                script {
                    def services = env.CHANGED_SERVICES.split(',')
                    def parallelStages = [:]

                    services.each { service ->
                        parallelStages[service] = {

                            stage("${service}: Maven Build & Unit Test") {
                                dir(service) {
                                    sh 'mvn clean verify'
                                }
                            }

                            stage("${service}: SonarQube Analysis") {
                                dir(service) {
                                    withSonarQubeEnv('SonarQube') {
                                        sh 'mvn sonar:sonar'
                                    }
                                }
                            }

                            stage("${service}: Quality Gate") {
                                timeout(time: 5, unit: 'MINUTES') {
                                    waitForQualityGate abortPipeline: true
                                }
                            }

                            stage("${service}: Docker Build") {
                                dir(service) {
                                    sh """
                                        docker build -t ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG} .
                                    """
                                }
                            }

                            stage("${service}: Trivy Scan") {
                                sh """
                                    trivy image --severity HIGH,CRITICAL --exit-code 1 ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                """
                            }

                            stage("${service}: Push to ECR") {
                                sh """
                                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                                    docker push ${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                """
                            }

                            stage("${service}: Helm Deploy") {
                                script {
                                    def namespace = service.replace('-service', '')
                                    def port = [
                                        'auth-service': 8081, 'gateway-service': 8080, 'user-service': 8082,
                                        'admin-service': 8094, 'employee-service': 8095, 'customer-service': 8084,
                                        'hr-service': 8096, 'task-service': 8089
                                    ][service]

                                    sh """
                                        aws eks update-kubeconfig --name ${EKS_CLUSTER} --region ${AWS_REGION}
                                        helm upgrade --install ${service} helm/crm \\
                                            -n ${namespace} \\
                                            --set name=${service} \\
                                            --set namespace=${namespace} \\
                                            --set port=${port} \\
                                            --set image=${ECR_REGISTRY}/vasavi-infra-dev-${service}:${IMAGE_TAG}
                                    """
                                }
                            }

                            stage("${service}: Wait for Rollout") {
                                script {
                                    def namespace = service.replace('-service', '')
                                    sh """
                                        kubectl rollout status deployment/${service} -n ${namespace} --timeout=180s
                                    """
                                }
                            }

                            stage("${service}: Smoke Test") {
                                script {
                                    def namespace = service.replace('-service', '')
                                    def port = [
                                        'auth-service': 8081, 'gateway-service': 8080, 'user-service': 8082,
                                        'admin-service': 8094, 'employee-service': 8095, 'customer-service': 8084,
                                        'hr-service': 8096, 'task-service': 8089
                                    ][service]

                                    sh """
                                        kubectl run smoke-test-${service}-${BUILD_NUMBER} --rm -i --restart=Never \\
                                            --image=curlimages/curl \\
                                            -- curl -sf http://${service}.${namespace}.svc.cluster.local:${port}/actuator/health
                                    """
                                }
                            }
                        }
                    }

                    parallel parallelStages
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline succeeded for changed services: ${env.CHANGED_SERVICES}"
        }
        failure {
            echo "Pipeline failed. Check the stage logs above for the genuine root cause."
        }
    }
}
